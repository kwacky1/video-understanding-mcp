{
  "name": "video-understanding-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for bounded, provenance-aware video understanding.",
  "license": "MIT",
  "author": "Simon Giesemann",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwacky1/video-understanding-mcp.git"
  },
  "homepage": "https://github.com/kwacky1/video-understanding-mcp#readme",
  "bugs": {
    "url": "https://github.com/kwacky1/video-understanding-mcp/issues"
  },
  "bin": {
    "video-understanding-mcp": "./dist/server.js",
    "vu-doctor": "./dist/doctor.js",
    "vu-generate-fixture": "./dist/generate-fixture.js"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "doctor": "node dist/doctor.js",
    "generate:fixture": "node dist/generate-fixture.js",
    "bootstrap:model": "sh scripts/bootstrap-whisper-model.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.0"
  }
}
